@page "/play"
@inject GameState Game
@inject NavigationManager Nav

<PageTitle>กำลังเล่น</PageTitle>

@if (Game.Started && Game.CurrentCard is { } card)
{
    var pct = Game.DeckSize == 0 ? 0 : Game.CardsShownThisRound * 100 / Game.DeckSize;
    var cur = Game.Players.ToList().IndexOf(Game.CurrentPlayer);

    <div class="hud">
        <span class="round">รอบ @Game.Round</span>
        <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@pct">
            <div class="bar" style="width:@(pct)%"></div>
        </div>
        <span class="meta">รอบที่ @Game.Round · ใบที่ @Game.CardsShownThisRound/@Game.DeckSize</span>
    </div>

    <div class="roster" aria-label="ผู้เล่น">
        @for (var i = 0; i < Game.Players.Count; i++)
        {
            var p = Game.Players[i];
            <span class="chip @(i == cur ? "active" : "")">
                <span class="avatar" style="background:@Avatar.Color(i)">@Avatar.Initial(p)</span>
                <span class="n">@p</span>
            </span>
        }
    </div>

    <div class="turn">
        <span class="avatar big" style="background:@Avatar.Color(cur)">@Avatar.Initial(Game.CurrentPlayer)</span>
        <span>ตาของ <strong>@Game.CurrentPlayer</strong></span>
    </div>

    <div class="stage" @key="@($"{Game.Round}-{Game.CardsShownThisRound}")">
        @if (!_revealed)
        {
            <button class="card-back" @onclick="Reveal" aria-label="แตะเพื่อเปิดการ์ด">
                <span class="pattern" aria-hidden="true">🍻</span>
                <span class="tap">แตะเพื่อเปิดการ์ด</span>
            </button>
        }
        else
        {
            <article class="card cat-@card.Category.ToString().ToLowerInvariant()">
                <div class="corner tl">@CategoryInfo.Emoji(card.Category)</div>
                <div class="corner br">@CategoryInfo.Emoji(card.Category)</div>
                <span class="badge">@CategoryInfo.Emoji(card.Category) @CategoryInfo.Label(card.Category)</span>
                <p class="text">@Game.CurrentText</p>
            </article>
        }
    </div>

    <button class="btn-main" disabled="@(!_revealed)" @onclick="NextCard">
        @(_revealed ? "ผู้เล่นคนต่อไป →" : "เปิดการ์ดก่อนนะ")
    </button>
    <button class="btn-link" @onclick="End">จบเกม</button>
}

@code {
    private bool _revealed;

    protected override void OnInitialized()
    {
        if (!Game.AgeConfirmed)
            Nav.NavigateTo("", replace: true);
        else if (!Game.Started)
            Nav.NavigateTo("setup", replace: true);
    }

    private void Reveal() => _revealed = true;

    private void NextCard()
    {
        Game.Next();
        _revealed = false;
    }

    private void End()
    {
        Game.Reset();
        Nav.NavigateTo("setup");
    }
}
