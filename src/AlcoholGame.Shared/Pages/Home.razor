@page "/"
@inject GameState Game
@inject NavigationManager Nav

<PageTitle>เกมวงเหล้า</PageTitle>

<section class="home">
    <div class="float f1" aria-hidden="true">🥃</div>
    <div class="float f2" aria-hidden="true">🍾</div>
    <div class="float f3" aria-hidden="true">🃏</div>
    <div class="float f4" aria-hidden="true">🍻</div>

    <div class="hero">
        <div class="logo" aria-hidden="true">🍻</div>
        <h1 class="title">วงเหล้า</h1>
        <div class="subtitle">เกมการ์ดคำสั่ง</div>
        <p class="tag">จั่วการ์ด ท้าทายเพื่อน ส่งมือถือต่อกันรอบวง</p>
    </div>

    <div class="gate">
        <div class="age">20+</div>
        <p>เกมนี้สำหรับผู้มีอายุ 20 ปีขึ้นไปเท่านั้น การดื่มเป็นทางเลือกของแต่ละคน ไม่อยากดื่มข้ามการ์ดได้เสมอ</p>
        <button class="btn-main" @onclick="Confirm">เริ่มเล่นเลย 🎲</button>
    </div>
</section>

@code {
    private void Confirm()
    {
        Game.AgeConfirmed = true;
        Nav.NavigateTo("setup");
    }
}
