@page "/"
@inject GameState Game
@inject NavigationManager Nav

<PageTitle>เกมวงเหล้า</PageTitle>

<section class="home">
    <div class="float f1" aria-hidden="true"><Icon Name="martini" Size="2rem" /></div>
    <div class="float f2" aria-hidden="true"><Icon Name="wine" Size="2.4rem" /></div>
    <div class="float f3" aria-hidden="true"><Icon Name="dice-5" Size="1.9rem" /></div>
    <div class="float f4" aria-hidden="true"><Icon Name="sparkles" Size="2rem" /></div>

    <div class="hero">
        <div class="logo" aria-hidden="true"><Icon Name="beer" Size="5rem" Stroke="1.6" /></div>
        <h1 class="title">วงเหล้า</h1>
        <div class="subtitle">เกมการ์ดคำสั่ง</div>
        <p class="tag">จั่วการ์ด ท้าทายเพื่อน ส่งมือถือต่อกันรอบวง</p>
    </div>

    <div class="gate">
        <div class="age">20+</div>
        <p>เกมนี้สำหรับผู้มีอายุ 20 ปีขึ้นไปเท่านั้น การดื่มเป็นทางเลือกของแต่ละคน ไม่อยากดื่มข้ามการ์ดได้เสมอ</p>
        <button class="btn-main" @onclick="Confirm"><span>เริ่มเล่นเลย</span><Icon Name="dice-5" Size="1.3em" /></button>
    </div>
</section>

@code {
    private void Confirm()
    {
        Game.AgeConfirmed = true;
        Nav.NavigateTo("setup");
    }
}
