@page "/setup"
@inject GameState Game
@inject DeckService Decks
@inject NavigationManager Nav

<PageTitle>ตั้งค่าเกม</PageTitle>

<header class="head">
    <h1>ใครเล่นบ้าง?</h1>
    <span class="count">@_players.Count/@GameState.MaxPlayers</span>
</header>

<form class="add-row" @onsubmit="AddPlayer" @onsubmit:preventDefault="true">
    <input @bind="_name" @bind:event="oninput" maxlength="20" placeholder="พิมพ์ชื่อแล้วกดเพิ่ม" aria-label="ชื่อผู้เล่น" />
    <button type="submit" class="btn-add" disabled="@(!CanAdd)"><Icon Name="plus" Size="1.1em" Stroke="2.5" /><span>เพิ่ม</span></button>
</form>

@if (_error is not null)
{
    <p class="error" role="alert">@_error</p>
}

@if (_players.Count == 0)
{
    <p class="empty">ยังไม่มีผู้เล่น เพิ่มอย่างน้อย @GameState.MinPlayers คน</p>
}
else
{
    <ul class="players">
        @for (var i = 0; i < _players.Count; i++)
        {
            var idx = i;
            var p = _players[i];
            <li>
                <span class="avatar" style="background:@Avatar.Color(idx)">@Avatar.Initial(p)</span>
                <span class="pname">@p</span>
                <button type="button" class="btn-x" aria-label="ลบ @p" @onclick="() => Remove(p)"><Icon Name="x" Size="1.2rem" /></button>
            </li>
        }
    </ul>
}

<h2>เลือกสำรับการ์ด</h2>
<div class="cats">
    @foreach (var c in Enum.GetValues<Category>())
    {
        var cat = c;
        var on = _cats.Contains(cat);
        <button type="button" class="tile cat-@cat.ToString().ToLowerInvariant() @(on ? "on" : "")"
                aria-pressed="@(on ? "true" : "false")" @onclick="() => ToggleCat(cat)">
            <span class="emoji"><Icon Name="@CategoryInfo.Icon(cat)" Size="1.9rem" /></span>
            <span class="label">@CategoryInfo.Label(cat)</span>
            <span class="hint">@CategoryInfo.Hint(cat) · @Decks.All.Count(x => x.Category == cat) ใบ</span>
            @if (on) { <span class="check" aria-hidden="true"><Icon Name="check" Size=".9rem" Stroke="3.5" /></span> }
        </button>
    }
</div>

<div class="start">
    <button class="btn-main" disabled="@(!CanStart)" @onclick="Start">
        @if (CanStart)
        {
            <span>แจกไพ่เลย!</span><Icon Name="sparkles" Size="1.3em" />
        }
        else
        {
            <span>เพิ่มผู้เล่นให้ครบก่อน</span>
        }
    </button>
</div>

@code {
    private readonly List<string> _players = [];
    private readonly HashSet<Category> _cats = [.. Enum.GetValues<Category>()];
    private string _name = "";
    private string? _error;

    private bool CanAdd => _name.Trim().Length > 0 && _players.Count < GameState.MaxPlayers;
    private bool CanStart => _players.Count >= GameState.MinPlayers && _cats.Count > 0;

    protected override void OnInitialized()
    {
        if (!Game.AgeConfirmed)
        {
            Nav.NavigateTo("", replace: true);
            return;
        }
        _players.AddRange(Game.Players);
    }

    private void AddPlayer()
    {
        var n = _name.Trim();
        if (n.Length == 0 || _players.Count >= GameState.MaxPlayers) return;
        if (_players.Contains(n, StringComparer.OrdinalIgnoreCase))
        {
            _error = $"มีชื่อ \"{n}\" อยู่แล้ว";
            return;
        }
        _error = null;
        _players.Add(n);
        _name = "";
    }

    private void Remove(string p) => _players.Remove(p);

    private void ToggleCat(Category c)
    {
        if (!_cats.Add(c)) _cats.Remove(c);
    }

    private void Start()
    {
        try
        {
            Game.Start(_players, _cats);
            Nav.NavigateTo("play");
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
    }
}
